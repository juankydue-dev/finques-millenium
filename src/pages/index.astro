---
/**
 * La redirección real de la raíz la hace el SERVIDOR (vercel.json / .htaccess).
 * Esta página solo existe como respaldo por si algún entorno sirve el archivo:
 * sin JavaScript ni meta refresh, con enlaces a cada idioma.
 */
import { DEMO } from '../config/site';
import { LANGS, path } from '../lib/i18n';
const nombres: Record<string, string> = { es: 'Español', ca: 'Català', en: 'English', fr: 'Français' };
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Finques Mil·lenium</title>
  <meta name="robots" content={DEMO ? 'noindex, nofollow' : 'noindex'} />
  <link rel="canonical" href={path('es', 'home')} />
  <style>
    body { font-family: system-ui, sans-serif; background: #0A1033; color: #f3efe6; display: grid; place-items: center; min-height: 100vh; margin: 0; }
    main { text-align: center; padding: 16px; }
    a { color: #d6ad5c; font-size: 1.2rem; margin: 0 10px; }
  </style>
</head>
<body>
  <main>
    <h1>Finques Mil·lenium</h1>
    <p>
      {LANGS.map((l) => <a href={path(l, 'home')} lang={l}>{nombres[l]}</a>)}
    </p>
  </main>
</body>
</html>
