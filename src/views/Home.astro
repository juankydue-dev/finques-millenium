    venderPasos: [
      { t: 'Free valuation', d: 'We study your home and give you its real market price.' },
      { t: 'Preparation', d: 'We advise on presentation and prepare a polished listing.' },
      { t: 'Visits', d: 'We organise viewings and screen prospective buyers.' },
      { t: 'Completion', d: 'We stand by you through negotiation, deposit and signing.' },
    ],
    venderCta: 'How we sell your home',
    zonasEyebrow: '04 · Areas',
    zonasTitulo: 'We know every street.',
    zonasLead: 'We work where we live. These are our areas.',
    zonasCta: 'See all areas',
    barrios: 'neighbourhoods',
    toolsEyebrow: '05 · Tools',
    toolsTitulo: 'The tools we work with, now at your service.',
    tools: [
      { href: 'valorar', titulo: 'Valuation tool', texto: 'Find out your home’s real market price, free and with no obligation.' },
      { href: 'hipoteca', titulo: 'Mortgage calculator', texto: 'Work out your monthly payment and purchase costs in a minute.' },
      { href: 'inversion', titulo: 'Yield calculator', texto: 'Clear numbers before you invest: gross and net returns.' },
      { href: 'alerta', titulo: 'Mil·lenium Alert', texto: 'We let you know when a home like the one you want comes in.' },
    ],
    invEyebrow: '06 · Investment',
    invTitulo: 'Returns you can actually calculate.',
    invTexto: 'Numbers first, then the investment. We know what sells and what rents in every neighbourhood, and every proposal comes with its yield calculated and costs itemised. If you wish, we will tell you when we spot an opportunity.',
    invPuntos: ['We know the real price, doorway by doorway', 'Numbers before promises', 'End-to-end management, purchase to rental'],
    invCta: 'Calculate a yield',
    invCta2: 'Receive opportunities',
    opinionesTitulo: 'Their words, not ours.',
    closingEyebrow: '07 · Start today',
    closingTitulo: 'What is your home worth today?',
    closingTexto: 'Type in the address and we will tell you, with real sales from your neighbourhood on the table. Free and with no obligation.',
    closingPlaceholder: 'Street and number, town',
    closingBtn: 'Free valuation',
    closingNota: 'No obligation. You can also just call us: we listen.',
  },
}[lang]!;

const props = destacados().slice(0, 4);
const secciones = { comprar: 'comprar', alquilar: 'alquilar', 'obra-nueva': 'obra-nueva', traspasos: 'traspasos', vender: 'vender', valorar: 'valorar', hipoteca: 'hipoteca', inversion: 'inversion', alerta: 'alerta' } as const;
const precios = [150000, 200000, 250000, 300000, 400000, 500000, 750000, 1000000];
const fmt = new Intl.NumberFormat(lang === 'en' ? 'en-GB' : 'es-ES');
/* Rutas de cada operación en este idioma, para que el buscador navegue sin tabla extra en JS */
const rutasOp = Object.fromEntries(
  (['comprar', 'alquilar', 'obra-nueva', 'traspasos'] as const).map((s) => [s, path(lang, s)])
);
---
<Base lang={lang} section="home" title={T.title} description={T.desc}>
  <section class="hero">
    <div class="hero__media">
      <Image src={img('hero-01')} alt="" widths={[768, 1280, 1920]} sizes="100vw" quality={62} loading="eager" fetchpriority="high" />
    </div>
    <div class="container hero__inner">
      <div>
        <span class="eyebrow">{T.eyebrow}</span>
        <h1>{fundacion ? T.h1ConAno : T.h1}</h1>
        <div class="hero__rule" role="presentation"></div>
        <p class="lead">{T.lead}</p>
      </div>
      <div class="hero__card">
        <h2 style="margin-bottom:10px">{T.buscar.titulo}</h2>
        <form class="hero-search" action={rutasOp['comprar']} method="get" data-hero-search data-rutas={JSON.stringify(rutasOp)}>
          <div class="hs-grid">
            <label>{T.buscar.operacion}
              <select name="operacion" data-hs-op>
                {T.buscar.ops.map((o) => <option value={o.v}>{o.l}</option>)}
              </select>
            </label>
            <label>{T.buscar.tipo}
              <select name="tipo">
                {T.buscar.tipos.map((o) => <option value={o.v}>{o.l}</option>)}
              </select>
            </label>
            <label>{T.buscar.municipio}
              <select name="zona">
                <option value="">{T.buscar.todas}</option>
                {zonasData.zonas.map((z) => <option value={z.slug}>{nz(z)}</option>)}
              </select>
            </label>
            <label>{T.buscar.precio}
              <select name="precio">
                <option value="">{T.buscar.sinLimite}</option>
                {precios.map((p) => <option value={p}>{fmt.format(p)} €</option>)}
              </select>
            </label>
          </div>
          <button class="btn btn--primary" type="submit">{T.buscar.btn}</button>
          <p class="hero-quick">
            <span style="color:var(--ink-soft)">{T.buscar.quick}</span>
            {T.buscar.quickLinks.map((q) => <a href={path(lang, secciones[q.href as keyof typeof secciones])}>{q.label}</a>)}
          </p>
        </form>
      </div>
    </div>
  </section>

  <div class="usp-strip">
    <div class="container">
      <ul>
        {T.usp.map((u) => <li>{u}</li>)}
      </ul>
    </div>
  </div>

  <section class="section" aria-labelledby="destacados-t">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{T.destacadosEyebrow}</span>
        <h2 id="destacados-t">{T.destacadosTitulo}</h2>
        <p class="lead">{T.destacadosLead}</p>
      </div>
      <div class="grid-cards">
        {props.map((i) => <PropCard lang={lang} inmueble={i} />)}
      </div>
      <p style="margin-top:26px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn--ghost" href={path(lang, 'comprar')}>{T.verComprar}</a>
        <a class="btn btn--ghost" href={path(lang, 'alquilar')}>{T.verAlquiler}</a>
      </p>
    </div>
  </section>

  <section class="section section--deep" aria-labelledby="nosotros-t">
    <div class="container split split--13">
      <div class="framed-img">
        <Image src={img('oficina-01')} alt={T.nosotrosImgAlt} widths={[480, 900]} sizes="(min-width: 900px) 42vw, 92vw" quality={70} />
      </div>
      <div>
        <span class="eyebrow">{T.nosotrosEyebrow}</span>
        <h2 id="nosotros-t">{T.nosotrosTitulo}</h2>
        <p style="margin-top:14px">{T.nosotrosParr1}</p>
        <p style="margin-top:10px">{T.nosotrosParr2}</p>
        <p style="margin-top:22px"><a class="btn btn--primary" href={path(lang, 'nosotros')}>{T.nosotrosCta}</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="vender-t">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{T.venderEyebrow}</span>
        <h2 id="vender-t">{T.venderTitulo}</h2>
        <p class="lead">{T.venderLead}</p>
      </div>
      <ol class="steps steps--row">
        {T.venderPasos.map((p) => <li><h3>{p.t}</h3><p>{p.d}</p></li>)}
      </ol>
      <p style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn--primary" href={path(lang, 'vender')}>{T.venderCta}</a>
        <a class="btn btn--ghost" href={path(lang, 'valorar')}>{ui.comunes.valorarGratis}</a>
      </p>
    </div>
  </section>

  <section class="section section--deep" aria-labelledby="zonas-t">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{T.zonasEyebrow}</span>
        <h2 id="zonas-t">{T.zonasTitulo}</h2>
        <p class="lead">{T.zonasLead}</p>
      </div>
      <div class="zone-grid">
        {zonasData.zonas.map((z) => (
          <article class="zone-card">
            <Image src={img(`zona-${z.slug}`)} alt="" widths={[480, 760]} sizes="(min-width: 700px) 340px, 92vw" quality={65} />
            <div class="zone-card__body">
              <h3><a href={path(lang, 'zonas', z.slug)}>{nz(z)}</a></h3>
              <p class="zone-card__meta">{z.barrios.length} {T.barrios}</p>
            </div>
          </article>
        ))}
      </div>
      <p style="margin-top:24px"><a href={path(lang, 'zonas')}>{T.zonasCta}</a></p>
    </div>
  </section>

  <section class="section section--navy" aria-labelledby="tools-t">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{T.toolsEyebrow}</span>
        <h2 id="tools-t">{T.toolsTitulo}</h2>
      </div>
      <div class="num-cols">
        {T.tools.map((h, idx) => (
          <div>
            <h3><span class="n" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span> <a href={path(lang, secciones[h.href as keyof typeof secciones])}>{h.titulo}</a></h3>
            <p style="color:rgba(243,239,230,.75)">{h.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="inv-t">
    <div class="container split">
      <div>
        <span class="eyebrow">{T.invEyebrow}</span>
        <h2 id="inv-t">{T.invTitulo}</h2>
        <p style="margin-top:14px">{T.invTexto}</p>
        <p style="margin-top:22px;display:flex;gap:12px;flex-wrap:wrap">
          <a class="btn btn--primary" href={path(lang, 'inversion') + '#calculadora'}>{T.invCta}</a>
          <a class="btn btn--ghost" href={path(lang, 'inversion')}>{T.invCta2}</a>
        </p>
      </div>
      <ul class="icon-list">
        {T.invPuntos.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <Reviews lang={lang} titulo={T.opinionesTitulo} />

  <section class="section section--navy" aria-labelledby="closing-t">
    <div class="container cta-band">
      <span class="eyebrow">{T.closingEyebrow}</span>
      <h2 id="closing-t">{T.closingTitulo}</h2>
      <p class="lead">{T.closingTexto}</p>
      <form class="closing-form" action={path(lang, 'valorar')} method="get">
        <div class="row">
          <label class="visually-hidden" for="closing-dir">{T.closingPlaceholder}</label>
          <input id="closing-dir" type="text" name="direccion" placeholder={T.closingPlaceholder} autocomplete="street-address" />
          <button class="btn btn--brass" type="submit">{T.closingBtn}</button>
        </div>
        <p class="hint">{T.closingNota} <a href={telHref(tel)} style="color:var(--brass-bright)">{tel}</a></p>
      </form>
    </div>
  </section>
</Base>
<script>
  // Buscador del hero: con JavaScript navega a la URL limpia de la sección y zona
  // (p. ej. /es/comprar/gava/?precio=300000&tipo=piso). Sin JavaScript, el GET
  // aterriza en el listado general, que sigue siendo funcional.
  const form = document.querySelector<HTMLFormElement>('[data-hero-search]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const rutas = JSON.parse(form.dataset.rutas!) as Record<string, string>;
    const d = new FormData(form);
    const op = String(d.get('operacion') || 'comprar');
    const zona = String(d.get('zona') || '');
    const q = new URLSearchParams();
    if (d.get('precio')) q.set('precio', String(d.get('precio')));
    if (d.get('tipo')) q.set('tipo', String(d.get('tipo')));
    const base = rutas[op] ?? rutas['comprar'];
    location.href = base + (zona ? zona + '/' : '') + (q.toString() ? '?' + q.toString() : '');
  });
</script>
