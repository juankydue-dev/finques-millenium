    zonasEyebrow: '04 · Zones',
    zonasTitulo: 'Coneixem cada carrer.',
    zonasLead: 'Treballem on vivim. Aquestes són les nostres zones.',
    zonasCta: 'Veure totes les zones',
    barrios: 'barris',
    toolsEyebrow: '05 · Eines',
    toolsTitulo: 'El que fem servir per treballar, ara a la seva disposició.',
    tools: [
      { href: 'valorar', titulo: 'Valorador', texto: 'Conegui el preu real de mercat del seu habitatge, gratis i sense compromís.' },
      { href: 'hipoteca', titulo: 'Calculadora hipotecària', texto: 'Calculi la seva quota mensual i les despeses de compra en un minut.' },
      { href: 'inversion', titulo: 'Calculadora de rendibilitat', texto: 'Números clars abans d’invertir: rendibilitat bruta i neta.' },
      { href: 'alerta', titulo: 'Alerta Mil·lenium', texto: 'L’avisem quan entri un habitatge com el que busca.' },
    ],
    invEyebrow: '06 · Inversió',
    invTitulo: 'Rendibilitat calculada, amb números clars.',
    invTexto: 'Abans d’invertir, els números. Sabem què es paga i què es lloga a cada barri, i cada proposta arriba amb la rendibilitat calculada i les despeses detallades. Si vol, l’avisem quan detectem una oportunitat.',
    invPuntos: ['Coneixem el preu real, portal a portal', 'Números abans que promeses', 'Gestió completa: de la compra al lloguer'],
    invCta: 'Calcular una rendibilitat',
    invCta2: 'Rebre oportunitats',
    opinionesTitulo: 'Ho diuen ells, no nosaltres.',
    closingEyebrow: '07 · Comenci avui',
    closingTitulo: 'Quant val avui el seu habitatge?',
    closingTexto: 'Escrigui l’adreça i l’hi diem amb les vendes reals del seu barri sobre la taula. Gratis i sense compromís.',
